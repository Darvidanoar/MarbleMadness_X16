; Zero-page variables (generated by tools/zpnames.py)
; unk_XX = access pattern known, purpose not yet identified

mapper_shadow   = $00     ; copy of last MAPPER_BANK write (bits 0-2 bank, bit 4 nametable)
ppuctrl_shadow  = $01     ; value written to PPUCTRL each frame
ppumask_shadow  = $02     ; value written to PPUMASK each frame
game_state      = $03     ; NMI dispatch index (x2) into table at $8532; $FF = only run sound
rng_seed        = $04     ; [3] random number generator state (sub_FC22)
rng_extra       = $07     ; [3] never written by the game; mixed into the RNG
frame_counter   = $0A     ; incremented every NMI
joy1_held       = $0B     ; controller 1 buttons held (A B Sel St U D L R = bit 7..0)
joy1_pressed    = $0C     ; controller 1 buttons newly pressed this frame
joy2_held       = $0D     ; controller 2 buttons held
joy2_pressed    = $0E     ; controller 2 buttons newly pressed this frame
farcall_ptr     = $0F     ; [2] FarCall target: low = A (JMP-table offset), high = $80
two_players     = $12     ; 0 = one player, 1 = two players (toggled with Select)
attract_cycle   = $13     ; bit 0 alternates title screen / demo on each attract loop
tmp0            = $14     ; scratch
tmp1            = $15     ; scratch
tmp2            = $16     ; scratch
tmp3            = $17     ; scratch
tmp4            = $18     ; scratch
tmp5            = $19     ; scratch
tmp6            = $1A     ; scratch (sometimes indexed as a 2-element array)
tmp7            = $1B     ; scratch
tmp8            = $1C     ; scratch (sometimes indexed as a 2-element array)
tmp9            = $1D     ; scratch
tmp10           = $1E     ; scratch (sometimes indexed as a 2-element array)
tmp11           = $1F     ; scratch
scroll_x        = $20     ; PPUSCROLL X
scroll_y        = $21     ; PPUSCROLL Y
joy1_raw        = $22     ; controller 1 shift register while reading (also scratch)
joy2_raw        = $23     ; controller 2 shift register while reading
ptr0            = $26     ; [2] general data pointer
ptr1            = $28     ; [2] general pointer / JMP (ptr1) dispatch vector / PPU address
oam_index       = $2A     ; next free byte in the OAM buffer at $0200
spr_attr        = $2D     ; sprite attribute byte being built
cursor_x        = $2E     ; name-entry cursor X
cursor_y        = $2F     ; name-entry cursor Y
map_scroll      = $30     ; [2] 16-bit vertical scroll position in the course map
unk_32          = $32     ; set to 8 at race start
scroll_offset   = $33     ; added to map_scroll ($00 or $E0)
race_number     = $34     ; 0-5: Practice, Beginner, Intermediate, Aerial, Silly, Ultimate
attr_addr_lo    = $35     ; attribute-table address low byte for the row being drawn
nt_row          = $36     ; nametable row index being drawn
nt_addr         = $37     ; [2] PPU address of the nametable row being drawn
ppu_addr_tmp    = $39     ; [2] PPU address scratch
ppu_tile_tmp    = $3B     ; tile byte scratch
cur_player      = $3C     ; player being processed (0/1)
gfx_ptr0        = $3D     ; [2] bank 1 sprite renderer source pointer
gfx_ptr1        = $3F     ; [2] bank 1 sprite renderer source pointer
control_type    = $41     ; [2] (x2) per-player control type (A = 90, B = 45 degrees); survives reset
time_subtick    = $43     ; frame counter for the race clock, wraps at 70
unk_44          = $44     ; [2] (x2)
unk_47          = $47
msg_id          = $48     ; current HUD message number ($FF = none)
msg_step        = $49     ; step counter of the message being drawn
score           = $4A     ; [6] player 1 = $4A-$4C, player 2 = $4D-$4F; base-100 digits, high first
unk_50          = $50
intro_timer     = $51     ; race-intro countdown (starts at $3E); input ignored while non-zero
msg_ptr         = $53     ; [2] pointer to the current message text
fx_x            = $55     ; [2] (x2) wobbling effect sprite X offset
fx_y            = $57     ; [2] (x2) effect sprite rising Y offset
fx_tile         = $59     ; [2] (x2) effect sprite tile ($7C-$7F)
unk_5B          = $5B     ; [2] (x2) per-player timer
unk_5D          = $5D     ; [2] (x2)
unk_5F          = $5F     ; [2] (x2)
unk_61          = $61     ; [2] (x2) countdown
vram_pending    = $63     ; non-zero = a VRAM block copy is queued for NMI
vram_dest       = $64     ; [2] PPU destination of the queued copy
vram_src        = $66     ; [2] source pointer of the queued copy
vram_end        = $68     ; end index (Y) of the queued copy
level_ptr0      = $69     ; [2] course data pointers, 6 per race, loaded from bank 2 $8072
level_ptr1      = $6B     ; [2]
level_ptr2      = $6D     ; [2]
level_ptr3      = $6F     ; [2]
level_ptr4      = $71     ; [2]
level_ptr5      = $73     ; [2]
unk_75          = $75
view_top        = $76     ; [2] map_scroll - $C0
attract_timer   = $78     ; title-screen timeout, decremented every 64 frames
unk_79          = $79     ; [2]
unk_7B          = $7B     ; flag
obj_list_count  = $7C     ; last index used in the object list at $0478
oam_index_save  = $7D     ; saved oam_index
unk_80          = $80     ; [2] (x2)
unk_82          = $82     ; [2] (x2)
unk_85          = $85
unk_88          = $88     ; [2] (x2)
unk_8A          = $8A     ; object index, $FF = none
plr_active      = $8B     ; [2] (x2) player is racing
plr_in_game     = $8D     ; [2] (x2) player is still in the game
saved_x         = $8F     ; [3] saved marble X (fraction, low, high), restored by sub_8A9D
saved_y         = $92     ; [3] saved marble Y (fraction, low, high)
unk_95          = $95
unk_96          = $96
unk_97          = $97
stackbuf_entry  = $98     ; [2] NMI jumps here into the unrolled PLA/STA PPUDATA copier
stackbuf_len    = $9A     ; bytes queued in the $0100 stack-page VRAM buffer
unk_9B          = $9B     ; animation counter
stackbuf_pos    = $9C     ; write index into the $0100 VRAM buffer
unk_9D          = $9D
seq_pos         = $9E     ; [3] (x3) bank 2 script interpreter: read position
seq_value       = $A1     ; [3] (x3) bank 2 script interpreter: current value
seq_repeat      = $A4     ; [3] (x3) bank 2 script interpreter: repeat count
seq_loop        = $A7     ; [3] (x3) bank 2 script interpreter: loop position
unk_AA          = $AA     ; VRAM-update flag
unk_AB          = $AB
unk_AC          = $AC     ; [2]
unk_AE          = $AE
ptr_AF          = $AF     ; [2] pointer
music_track     = $B1     ; music/sound request, read by the bank 3 sound driver
snd_tick        = $B2     ; sound driver tick counter
snd_tempo       = $B3     ; sound driver ticks per step
snd_ptr         = $B4     ; [2] sound driver channel data pointer
snd_tmp         = $B6     ; sound driver scratch
snd_cmd_vector  = $B7     ; [2] sound driver command dispatch vector
snd_tempo_acc   = $B9     ; fractional tempo accumulator
snd_tempo_step  = $BA     ; fractional tempo step
unk_BB          = $BB
unk_BC          = $BC     ; [2] (x2)
unk_BE          = $BE
unk_BF          = $BF
unk_C0          = $C0
unk_C1          = $C1
unk_C2          = $C2     ; end-of-race delay
unk_C5          = $C5     ; [2] (x2) fractional accumulator
unk_CA          = $CA     ; timer
msg_row         = $CB     ; HUD message row
msg_text_pos    = $CC     ; offset in msg_ptr of the next character
msg_row_copy    = $CD
msg_ppu_lo      = $CE     ; low byte of the message PPU address
unk_CF          = $CF     ; [2] (x2) $FF = none
unk_D1          = $D1
msg_counter     = $D2     ; message timer (starts at $1F)
sfx_queue       = $D3     ; [4] sound-effect requests, consumed by the sound driver
unk_D7          = $D7     ; course-data read index (bank 2)
unk_D8          = $D8
ppu_addr2       = $D9     ; [2] PPU address
unk_DB          = $DB
unk_DC          = $DC
unk_DD          = $DD
unk_DE          = $DE     ; [2] (x2) countdown
unk_E0          = $E0     ; [2] (x2)
unk_E2          = $E2     ; [2] (x2)
unk_E4          = $E4     ; [2] (x2)
unk_E6          = $E6
unk_E7          = $E7     ; [2] (x2)
unk_E9          = $E9
ptr_EA          = $EA     ; [2] pointer (bank 1)
unk_EC          = $EC     ; [2] (x2)
unk_EE          = $EE
unk_EF          = $EF
unk_F0          = $F0     ; [2] (x2)
unk_F2          = $F2     ; [2] (x2)
unk_F4          = $F4     ; [2] (x2)
unk_F6          = $F6     ; [2] (x2)
unk_F8          = $F8
unk_F9          = $F9     ; [2] (x2)
unk_FB          = $FB     ; [2] (x2) subtracted from object height $03C0
unk_FD          = $FD     ; [2] (x2)
unk_FF          = $FF     ; flag

; Bank-specific aliases (same address, different use in that bank)
fine_x          = $2E     ; bank 1: object X & 7 (bank 1 sprite renderer)
fine_y          = $2F     ; bank 1: object Y & 7 (bank 1 sprite renderer)
saved_sp        = $8F     ; bank 1: stack pointer saved while the stack is used as a data source
b2_tmp_8F       = $8F     ; bank 2: scratch (bank 2)
b3_ptr_22       = $22     ; bank 3: pointer (bank 3)
